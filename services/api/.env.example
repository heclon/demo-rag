# Everything here has a working default baked into app/config.py, so this file
# is entirely optional — the API boots without it. Copy to services/api/.env
# only if you want to change something.

LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# Matches docker-compose.yml.
DATABASE_URL=postgresql+psycopg://demo:demo@localhost:5432/demo_rag
OPENSEARCH_ENDPOINT=https://localhost:9200
OPENSEARCH_INDEX=product_reviews

# --- Optional upgrade 1: real LLM reasoning -------------------------------
# Default 'mock' uses deterministic rules for Text-to-SQL, agent routing and
# answer synthesis — no key, no network. Switch to 'anthropic' for real Claude.
LLM_PROVIDER=mock
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5

# --- Optional upgrade 2: real dense embeddings ----------------------------
# Default 'local' is an offline hashing vectorizer (real lexical retrieval, no
# model download). Switch to 'voyage' for true semantic embeddings.
EMBEDDING_PROVIDER=local
# VOYAGE_API_KEY=pa-...
# VOYAGE_MODEL=voyage-3.5-lite
